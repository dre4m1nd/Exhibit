# Remote OpenAI-compatible endpoint. API key is required.
EXHIBIT_BASE_URL=https://api.openai.com/v1
EXHIBIT_API_KEY=
EXHIBIT_MODEL=gpt-5.4-mini

# Agent guardrails
EXHIBIT_MAX_ITERS=60
EXHIBIT_TIMEOUT=600

# Optional: directory containing all prompt Markdown files
# EXHIBIT_PROMPT_DIR=D:\Code\Exhibit\agent\prompts

# Optional: explicit interpreter for the TUI to spawn
# EXHIBIT_PYTHON=D:\Code\Exhibit\.venv\Scripts\python.exe
