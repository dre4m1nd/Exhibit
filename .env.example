# Remote OpenAI-compatible endpoint. Required for headless/CI runs.
# In the TUI, `/login` is preferred and saves credentials outside the repo.
EXHIBIT_BASE_URL=https://api.openai.com/v1
EXHIBIT_API_KEY=
EXHIBIT_MODEL=gpt-5.4-mini

# Custom local gateway example (the loopback exception applies only to custom):
# EXHIBIT_PROVIDER=custom
# EXHIBIT_BASE_URL=http://127.0.0.1:3425/v1
# EXHIBIT_API_KEY=magpie
# EXHIBIT_MODEL=group/master

# OpenRouter shortcut for headless runs. Leave the OpenAI settings above empty
# when using this variable; it selects https://openrouter.ai/api/v1 and
# openrouter/free automatically.
# OPENROUTER_API_KEY=

# Optional when more than one provider was saved through /login.
EXHIBIT_PROVIDER=

# Agent guardrails
EXHIBIT_MAX_ITERS=60
EXHIBIT_TIMEOUT=600
# Maximum tokens the model may emit for one review/report. Raise this if
# long reports are truncated before reaching their conclusion.
EXHIBIT_MAX_OUTPUT_TOKENS=16000

# Optional: directory containing all prompt Markdown files
# EXHIBIT_PROMPT_DIR=D:\Code\Exhibit\agent\prompts

# Optional: explicit interpreter for the TUI to spawn
# EXHIBIT_PYTHON=D:\Code\Exhibit\.venv\Scripts\python.exe
